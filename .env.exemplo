# Copie para .env (cp .env.exemplo .env) e preencha. O .env nunca vai para o git.

# Domínio do painel: um só, sem https://, sem porta e sem aspas. O DNS dele precisa apontar para este servidor.
SINAN_HOSTS=painel.prism.ufrr.br

# Branch usada pelo scripts/painel.sh implantar: main ou develop.
SINAN_RAMO=main
